          "steps": [["t(ʰ?)y","cc$1"],["d(ʰ?)y","jj$1"],["[nṇ]y","ññ"],["hy","jjʰ"],["hv","bbʰ"]]
        },
        {
          "id": "s09", "phase": "core",
          "say": "ry becomes yy; a vowel opens rh, and a consonant before l at the start of a word; ml becomes mm; hr at the start of a word loses its h",
          "ex": [["sūrya","sūyya"],["kleśa","kileśa"],["āmla","āmma"]],
          "steps": [["ry","yy"],["rh","rah"],["^hr","r"],["^([kgpbmśs])l","$1il"],["ml","mm"]]
