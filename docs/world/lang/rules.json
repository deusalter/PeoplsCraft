          "ex": [["dvāra","bāra"],["pakva","pakka"],["alpa","appa"],["aśva","aśśa"],["kāvya","kābba"]],
          "steps": [["^dv","b"],["dv","bb"],["({P})(ʰ?)[yv]","$1$1$2"],["([lmśṣs])y","$1$1"],["([śṣsl])v","$1$1"],["l({P})","$1$1"],["lm","mm"],["({P})(ʰ?)l","$1$1$2"],["vy","vv"],["vv","bb"]]
        },
        {
          "id": "s13", "phase": "core",
          "say": "Three consonants make two; a doubled consonant is single after a nasal and at the start of a word; h after a nasal is lost and the nasal doubles",
          "ex": [["canddda","canda"],["ttʰāna","tʰāna"],["uṇha","uṇṇa"]],
          "steps": [["({C})\\1{2,}","$1$1"],["([ṅñṇnm])([kgcjṭḍtdpbśṣs])\\2","$1$2"],["^({C})\\1","$1"],["^([ñnṇm])h","$1"],["([ñnṇm])h","$1$1"]]
        },
        {
          "id": "s14", "phase": "core",
          "say": "Before a consonant, ava draws together to o and aya to e",
          "ex": [["lavaṇa","loṇa"],["pavana","pona"],["nayana","nena"]],
          "steps": [["ava(?={C})","o"],["aya(?={C})","e"]]
        },
        {
          "id": "s15", "phase": "core",
          "say": "k, t and p alone between vowels, or after a nasal, become g, d and b; ṭ becomes ḍ after a nasal; ṭ and ḍ alone between vowels become r",
          "ex": [["loka","loga"],["śīta","śīda"],["dīpa","dība"],["danta","danda"],["kaṇṭaka","kaṇḍaga"],["kīṭa","kīra"]],
          "steps": [["(?<={V}|[ṅñṇnm])k(?={V})","g"],["(?<={V}|[ṅñṇnm])t(?={V})","d"],["(?<={V}|[ṅñṇnm])p(?={V})","b"],["(?<=[ṅñṇnm])ṭ(?={V})","ḍ"],["(?<={V})(?:ṭ|ḍʰ?)(?={V})","r"]]
        },
        {
          "id": "s16", "phase": "core",
          "say": "A doubled consonant becomes single, and a short vowel before it grows long",
          "ex": [["hattʰa","hātʰa"],["aggi","āgi"],["sukkʰa","sūkʰa"],["rātti","rāti"]],
          "steps": [["a({C})\\1","ā$1"],["i({C})\\1","ī$1"],["u({C})\\1","ū$1"],["({C})\\1","$1"]]
        },
        {
          "id": "s17", "phase": "core",
          "say": "All breath is lost; the curled consonants and the five nasals fall in with t, d, n and m",
          "ex": [["hātʰa","hāta"],["megʰa","mega"],["pāṣāṇa","pāṣāna"]],
          "steps": [["ʰ",""],["ṭ","t"],["ḍ","d"],["[ṇṅñ]","n"],["ḷ","l"]]
        },
        {
          "id": "s18", "phase": "core",
          "say": "Every sibilant is said sh (written ś until the spelling step); then c becomes s",
          "ex": [["sāra","śāra"],["canda","sanda"],["pāca","pāsa"]],
          "steps": [["[ṣs]","ś"],["c","s"]]
        },
        {
          "id": "s19", "phase": "core",
          "say": "j becomes z, and so does y at the start of a word; v becomes b",
          "ex": [["jala","zala"],["yūta","zūta"],["vana","bana"]],
          "steps": [["j","z"],["^y","z"],["v","b"]]
