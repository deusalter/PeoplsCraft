      "spelling": {"say": "The sibilant is written sh", "ex": [["śila","shila"]], "steps": [["ś","sh"]]},
      "join": {
        "mode": "loose",
        "say": "Each word is worn down by itself first and the two are then set side by side, describing word first. Every long vowel of the first word is short. The first word keeps its old stem vowel, which falls before a vowel. An ending (a word written with a leading hyphen) is joined the old way, before the changes run.",
        "ex": [[["vālukā","bhūmi"],"Balugabūmi"],[["kāca","śakala"],"Kasashagala"],[["loha","-kāra"],"Lohagāra"]],
